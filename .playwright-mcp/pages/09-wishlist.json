{
  "page": "Wishlist",
  "url": {
    "pattern": "/wishlist",
    "full": "https://sedigaplanit.github.io/AI-R-D---Github-copilot/wishlist",
    "title": "E-Commerce App",
    "authRequired": false
  },
  "states": {
    "empty": {
      "heartIcon": "♡ generic element",
      "heading": { "role": "heading", "level": 2, "name": "Your wishlist is empty" },
      "description": { "text": "Save items you love by clicking the heart on any product." },
      "startShoppingButton": { "role": "button", "name": "Start Shopping", "navigatesTo": "/" }
    },
    "withItems": {
      "heading": {
        "role": "heading",
        "level": 1,
        "name": "My Wishlist",
        "class": "wishlist-title"
      },
      "itemCount": {
        "tag": "p",
        "class": "wishlist-subtitle",
        "locator": "locator('.wishlist-subtitle')",
        "textPattern": "{N} item saved (singular) / {N} items saved (plural)",
        "note": "Live app (2026-07-24): '1 item saved' — NOT '1 item(s) saved'. Plural varies by count."
      },
      "itemGrid": {
        "containerClass": "wishlist-grid",
        "itemClass": "wishlist-item-wrapper",
        "locator": "locator('.wishlist-item-wrapper')",
        "cardCount": "locator('.wishlist-item-wrapper').count()"
      },
      "itemCard": {
        "imageWrapper": ".item-img-wrapper",
        "imageLocator": "locator('.wishlist-grid img').first()",
        "imageNote": "Product image has no alt text — use locator CSS selector, not getByRole('img')",
        "productLink": "getByRole('link') inside .item-img-wrapper — href: /product/{id}",
        "productName": "paragraph inside .wishlist-item-wrapper (first p after price container)",
        "productNameLocator": "locator('.wishlist-item-wrapper p').first()",
        "salePriceLocator": "locator('.wishlist-grid [class*=\"price\"]').nth(1)",
        "originalPriceLocator": "locator('.wishlist-grid [class*=\"price\"]').nth(2)",
        "priceContainerNote": "3 [class*='price'] elements per card: container + sale price + original price"
      },
      "itemName": { "tag": "p", "locator": "getByText('product name')" },
      "wishlistedToggle": {
        "tag": "BUTTON",
        "class": "item-wishlist-btn wishlisted",
        "text": "♥",
        "locator": "locator('button.item-wishlist-btn.wishlisted')",
        "note": "Filled heart — click to remove from wishlist"
      },
      "quantityControls": {
        "decrement": "getByRole('button', { name: '−' })",
        "increment": "getByRole('button', { name: '+' })"
      }
    }
  },
  "wishlistToggle": {
    "locations": [
      "Product card on landing page",
      "Product card on category pages",
      "Product detail page"
    ],
    "locator": "getByRole('button', { name: '♡' })",
    "behavior": "Toggles item in/out of wishlist"
  },
  "screenshot": "snapshots/10-wishlist-empty.png"
}
