{
  "page": "My Orders (Order History)",
  "url": {
    "pattern": "/orders",
    "full": "https://sedigaplanit.github.io/AI-R-D---Github-copilot/orders",
    "title": "E-Commerce App",
    "authRequired": true,
    "knownGap": "No route guard — unauthenticated users who navigate directly to /orders are NOT redirected to /login; the frontend renders an empty order list instead."
  },
  "elements": {
    "heading": { "role": "heading", "level": 1, "name": "Order History" },
    "orderCount": {
      "locator": "locator('.orderhistory-subtitle')",
      "textPattern": "X orders placed",
      "example": "291 orders placed"
    },
    "orderCard": {
      "description": "One card per order — confirmed from live app 2026-07-27",
      "containerClass": ".orderhistory-card",
      "listClass": ".orderhistory-list",
      "headerClass": ".orderhistory-card-header",
      "orderIdSpan": "span.orderhistory-order-id — e.g. 'ORD-793662' or 'ORD-20260727-DBRT'",
      "dateSpan": "span.orderhistory-date — e.g. '27 July 2026'",
      "statusSpan": "span.orderhistory-status — e.g. 'Delivered'",
      "totalSpan": "span.orderhistory-total — e.g. 'LKR 50.00'",
      "itemRow": {
        "productImage": "img with product name as alt text",
        "productName": "paragraph — product name text",
        "qtyAndPrice": "paragraph — e.g. 'Qty: 1  ·  LKR 50 each'",
        "lineTotal": "paragraph — e.g. 'LKR 50.00'"
      },
      "itemCount": "'N item' or 'N items' — e.g. '1 item'",
      "totalPaidLabel": "'Total paid: LKR X.XX' — e.g. 'Total paid: LKR 50.00'"
    },
    "emptyState": {
      "description": "Shown when user has no orders — structure from AC5, not confirmed via live app inspection",
      "icon": "📦",
      "heading": { "role": "heading", "level": 2, "name": "No orders yet" },
      "message": "'You haven\\'t placed any orders. Start shopping!'",
      "button": { "role": "button", "name": "Shop Now", "navigatesTo": "/" }
    }
  },
  "unauthenticatedBehaviour": {
    "confirmed": "2026-07-26",
    "behaviour": "Page renders at /orders with no redirect to /login. When auth token is absent the GET /api/orders call returns 401 and no order cards are displayed — the frontend silently shows an empty state. See knownGap."
  },
  "sampleOrderStructure": {
    "orderId": "ORD-XXXXXX (6 digits)",
    "dateFormat": "DD Month YYYY (e.g. '26 July 2026')",
    "statusValues": ["Delivered"],
    "totalFormat": "LKR X.XX",
    "totalPaidFooter": "Total paid: LKR X.XX"
  },
  "locators": {
    "pageHeading": "getByRole('heading', { level: 1, name: 'Order History' })",
    "orderCountSubtitle": "locator('.orderhistory-subtitle')",
    "orderCardList": "locator('.orderhistory-list')",
    "orderCard": "locator('.orderhistory-card')",
    "orderCardHeader": "locator('.orderhistory-card-header')",
    "orderDate": "locator('.orderhistory-date')",
    "emptyHeading": "getByRole('heading', { level: 2, name: 'No orders yet' })",
    "shopNowButton": "getByRole('button', { name: 'Shop Now' })"
  }
}
